module example {
  yang-version 1.1;
  namespace "urn:example:simple";
  prefix "ex";

  organization "xconf lab";
  description
    "Minimal YANG module for multi-protocol testing: one container
     holding a single configurable leaf.";

  revision 2026-11-10 {
    description "Initial revision for the xconf multi-protocol lab.";
  }

  container system {
    description "Top-level configuration container.";

    leaf hostname {
      type string;
      default "default-host";
      description "The configured hostname of the device.";
    }
  }
}
